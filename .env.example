# ── LLM Provider ───────────────────────────────────────────────────────────
# Choose one: groq | anthropic | openai
LLM_PROVIDER=groq

# ── API Keys (only the one matching LLM_PROVIDER is required) ──────────────
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Storage Paths ──────────────────────────────────────────────────────────
REPOS_DIR=/tmp/repos
EMBEDDINGS_DIR=/tmp/embeddings
GRAPHS_DIR=/tmp/graphs

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Indexing Limits ────────────────────────────────────────────────────────
MAX_FILES_TO_SUMMARIZE=80
MAX_FILE_SIZE_KB=50